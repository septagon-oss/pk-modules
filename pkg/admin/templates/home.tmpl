{{define "home"}}{{template "layout" .}}{{end}}
{{define "content"}}
<section class="pk-hero">
  <div>
    <p class="pk-eyebrow">Composed application</p>
    <h1>Know what is running.<br><em>Operate what matters.</em></h1>
    <p class="pk-lede">A focused view of the resources and actions exposed by this PlatformKit instance.</p>
  </div>
  <div class="pk-runtime-stamp" aria-label="Runtime status operational">
    <span class="pk-status-light" aria-hidden="true"></span>
    <div><strong>Operational</strong><small>Runtime responding</small></div>
  </div>
</section>

<dl class="pk-stats" aria-label="Admin surface summary">
  <div class="pk-stat"><dt>Managed areas</dt><dd>{{.Stats.Areas}}</dd></div>
  <div class="pk-stat"><dt>Collections</dt><dd>{{.Stats.Collections}}</dd></div>
  <div class="pk-stat"><dt>Available actions</dt><dd>{{.Stats.Actions}}</dd></div>
</dl>

<section class="pk-section">
  <div class="pk-section-head">
    <div>
      <p class="pk-eyebrow">Management index</p>
      <h2>Application areas</h2>
    </div>
    <span class="pk-section-note">Generated from registered module contracts</span>
  </div>

  <div class="pk-module-index">
    {{range $index, $module := .Modules}}
    <article class="pk-module-row">
      <span class="pk-module-number" aria-hidden="true">{{printf "%02d" (inc $index)}}</span>
      <div class="pk-module-copy">
        <h3>{{$module.DisplayName}}</h3>
        {{if $module.Description}}<p>{{$module.Description}}</p>{{end}}
      </div>
      <div class="pk-module-links">
        {{range $module.Resources}}
        <a href="{{$.BasePath}}/{{.ModuleID}}/{{.EntityName}}">
          <span>{{.PluralLabel}}</span><span aria-hidden="true">↗</span>
        </a>
        {{end}}
        {{range $module.Pages}}<a href="{{.Path}}"><span>{{.Title}}</span><span aria-hidden="true">↗</span></a>{{end}}
      </div>
    </article>
    {{else}}
    <div class="pk-empty-state">
      <span class="pk-empty-glyph" aria-hidden="true">＋</span>
      <h3>No management areas yet</h3>
      <p>Register a schema-aware resource from a module to make it available here.</p>
    </div>
    {{end}}
  </div>
</section>
{{end}}
