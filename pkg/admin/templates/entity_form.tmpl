{{define "entity_form"}}{{template "layout" .}}{{end}}
{{define "content"}}
<section class="pk-form-page" data-pk-page="resource-form" data-resource-config="{{.ResourceConfig}}" data-resource-id="{{.EntityID}}" data-list-path="{{.BasePath}}/{{.Resource.ModuleID}}/{{.Resource.EntityName}}">
  <header class="pk-page-head">
    <div>
      <a class="pk-backlink" href="{{.BasePath}}/{{.Resource.ModuleID}}/{{.Resource.EntityName}}">← {{.Resource.PluralLabel}}</a>
      <p class="pk-eyebrow">{{.Resource.ModuleID}}</p>
      <h1>{{if .EntityID}}Edit {{.Resource.SingularLabel}}{{else}}New {{.Resource.SingularLabel}}{{end}}</h1>
      {{if .Resource.Description}}<p class="pk-lede">{{.Resource.Description}}</p>{{end}}
    </div>
  </header>

  <form class="pk-admin-form" id="pk-resource-form" novalidate>
    <div class="pk-form-status" id="pk-form-status" role="alert" aria-live="assertive" hidden></div>
    <fieldset>
      <legend>Details</legend>
      <div class="pk-field-grid">
      {{range .Resource.Fields}}
        {{if eq .Kind "boolean"}}
        <label class="pk-check-field" for="field-{{.Key}}">
          <input id="field-{{.Key}}" name="{{.Key}}" type="checkbox" {{if .ReadOnly}}disabled{{end}}>
          <span><strong>{{.Label}}</strong>{{if .Help}}<small>{{.Help}}</small>{{end}}</span>
        </label>
        {{else}}
        <label class="pk-field {{if eq .Kind "textarea"}}pk-field-wide{{end}}" for="field-{{.Key}}">
          <span>{{.Label}}{{if .Required}} <b aria-hidden="true">*</b><span class="pk-visually-hidden"> required</span>{{end}}</span>
          {{if eq .Kind "textarea"}}
          <textarea id="field-{{.Key}}" name="{{.Key}}" rows="8" {{if .Placeholder}}placeholder="{{.Placeholder}}"{{end}} {{if or .Required (and (not $.EntityID) .RequiredOnCreate)}}required{{end}} {{if .ReadOnly}}readonly{{end}}></textarea>
          {{else if eq .Kind "select"}}
          <select id="field-{{.Key}}" name="{{.Key}}" {{if or .Required (and (not $.EntityID) .RequiredOnCreate)}}required{{end}} {{if .ReadOnly}}disabled{{end}}>
            {{if not .Required}}<option value="">Choose…</option>{{end}}
            {{range .Options}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
          </select>
          {{else}}
          <input id="field-{{.Key}}" name="{{.Key}}"
            type="{{if eq .Kind "email"}}email{{else if eq .Kind "password"}}password{{else if eq .Kind "number"}}number{{else if eq .Kind "datetime"}}datetime-local{{else}}text{{end}}"
            {{if eq .Kind "slug"}}pattern="[a-z0-9]+(?:-[a-z0-9]+)*" autocapitalize="none" spellcheck="false"{{end}}
            {{if .Placeholder}}placeholder="{{.Placeholder}}"{{end}}
            {{if or .Required (and (not $.EntityID) .RequiredOnCreate)}}required{{end}} {{if .ReadOnly}}readonly{{end}}
            {{if eq .Kind "number"}}{{if .Min}}min="{{.Min}}"{{end}} {{if .Max}}max="{{.Max}}"{{end}}{{else if eq .Kind "password"}}{{if .Min}}minlength="{{.Min}}"{{end}} {{if .Max}}data-max-utf8-bytes="{{.Max}}"{{end}}{{else}}{{if .Min}}minlength="{{.Min}}"{{end}} {{if .Max}}maxlength="{{.Max}}"{{end}}{{end}}>
          {{end}}
          {{if .Help}}<small id="field-{{.Key}}-help">{{.Help}}</small>{{end}}
        </label>
        {{end}}
      {{end}}
      </div>
    </fieldset>

    <div class="pk-form-actions">
      <button class="pk-btn pk-btn-primary" id="pk-form-submit" type="submit">
        {{if .EntityID}}Save changes{{else}}Create {{.Resource.SingularLabel}}{{end}}
      </button>
      <a class="pk-btn" href="{{.BasePath}}/{{.Resource.ModuleID}}/{{.Resource.EntityName}}">Cancel</a>
    </div>
  </form>

  <section class="pk-secret-panel" id="pk-secret-panel" aria-live="polite" hidden>
    <p class="pk-eyebrow">Copy this value now</p>
    <h2>Created successfully</h2>
    <p>This secret is shown once. Store it somewhere safe before leaving.</p>
    <div class="pk-secret-row"><code id="pk-secret-value"></code><button class="pk-btn" id="pk-secret-copy" type="button">Copy</button></div>
    <a class="pk-btn pk-btn-primary" href="{{.BasePath}}/{{.Resource.ModuleID}}/{{.Resource.EntityName}}">Return to {{.Resource.PluralLabel}}</a>
  </section>
</section>
{{end}}
