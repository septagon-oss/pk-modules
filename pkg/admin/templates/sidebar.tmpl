{{define "sidebar"}}
{{- if .Sidebar -}}
{{range .Sidebar}}
  <section class="pk-nav-section" aria-labelledby="nav-{{.ModuleID}}">
    <h2 id="nav-{{.ModuleID}}">{{.Label}}</h2>
    <ul>
      {{range .Items}}
      <li>
        <a href="{{.Path}}" {{if eq $.CurrentPath .Path}}aria-current="page"{{end}}>
          <span>{{.Label}}</span><span class="pk-nav-arrow" aria-hidden="true">›</span>
        </a>
      </li>
      {{end}}
    </ul>
  </section>
{{end}}
{{- else -}}
  <p class="pk-nav-empty">No management areas registered.</p>
{{- end -}}
{{end}}
