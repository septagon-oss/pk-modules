{{define "layout"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{.Title}} — {{.PageTitle}}</title>
  <link rel="stylesheet" href="{{.BasePath}}/static/_admin.css">
</head>
<body>
  <header class="pk-admin-header">
    <h1><a href="{{.BasePath}}" style="color:inherit;text-decoration:none">{{.Title}}</a></h1>
    <span class="pk-muted">{{.PageTitle}}</span>
  </header>
  <div class="pk-admin-layout">
    <aside class="pk-admin-sidebar">{{template "sidebar" .}}</aside>
    <main class="pk-admin-content">{{template "content" .}}</main>
  </div>
</body>
</html>
{{end}}
