{{define "layout"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title>{{.PageTitle}} · {{.Title}}</title>
  <link rel="stylesheet" href="{{.BasePath}}/static/_admin.css">
  <script defer src="{{.BasePath}}/static/_admin.js"></script>
</head>
<body>
  <a class="pk-skip-link" href="#main-content">Skip to content</a>
  <header class="pk-admin-header">
    <a class="pk-brand" href="{{.BasePath}}" aria-label="{{.Title}} overview">
      <span class="pk-brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>
        <strong>{{.Title}}</strong>
        <small>Operator workspace</small>
      </span>
    </a>

    <div class="pk-header-tools">
      {{if .TenantID}}
      <div class="pk-identity" title="Signed in as {{.Subject}} for tenant {{.TenantID}}">
        <span class="pk-presence" aria-hidden="true"></span>
        <span class="pk-identity-copy">
          <strong>{{.Subject}}</strong>
          <small>{{.TenantID}}</small>
        </span>
      </div>
      {{end}}
      <form method="post" action="{{.BasePath}}/logout">
        <button class="pk-icon-btn" type="submit" aria-label="Sign out">Sign out</button>
      </form>
      <details class="pk-mobile-nav">
        <summary aria-label="Open navigation">Menu</summary>
        <nav aria-label="Mobile navigation">
          <a class="pk-overview-link" href="{{.BasePath}}" {{if eq .CurrentPath .BasePath}}aria-current="page"{{end}}>Overview</a>
          {{template "sidebar" .}}
        </nav>
      </details>
    </div>
  </header>

  <div class="pk-admin-layout">
    <aside class="pk-admin-sidebar" aria-label="Primary navigation">
      <nav>
        <a class="pk-overview-link" href="{{.BasePath}}" {{if eq .CurrentPath .BasePath}}aria-current="page"{{end}}>
          <span aria-hidden="true">⌂</span> Overview
        </a>
        {{template "sidebar" .}}
      </nav>
      <div class="pk-sidebar-foot">
        <span>PlatformKit OSS</span>
        <a href="/healthz">System health ↗</a>
      </div>
    </aside>

    <main class="pk-admin-content" id="main-content" tabindex="-1">
      <div class="pk-content-frame">
        {{template "content" .}}
      </div>
    </main>
  </div>
  <div class="pk-toast" id="pk-toast" role="status" aria-live="polite" hidden></div>
</body>
</html>{{end}}
